# Local development only. Copy to .env and change the values before starting Docker.
APP_ENV=local
LOG_LEVEL=INFO

# Pinned images and libraries used by FND-01.
RUSTFS_VERSION=1.0.0-alpha.81
POLARIS_VERSION=1.7.0
POLARIS_ADMIN_VERSION=1.7.0
POSTGRES_VERSION=18.6
SPARK_VERSION=3.5.9-java17-python3
ICEBERG_VERSION=1.10.1
AWS_CLI_VERSION=2.36.44
ALPINE_CURL_VERSION=8.22.0

# RustFS S3-compatible object storage.
RUSTFS_ENDPOINT=http://host.docker.internal:9000
RUSTFS_INTERNAL_ENDPOINT=http://rustfs:9000
RUSTFS_CONSOLE_ENDPOINT=http://localhost:9001
RUSTFS_BUCKET=data-platform
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=pdp_local_access
RUSTFS_SECRET_KEY=change-me-rustfs-secret

# Apache Polaris REST catalog.
POLARIS_ENDPOINT=http://localhost:8181/api/catalog
POLARIS_INTERNAL_ENDPOINT=http://polaris:8181/api/catalog
POLARIS_REALM=POLARIS
POLARIS_CATALOG=fnd01_catalog
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-me-polaris-secret

# PostgreSQL persistence for Polaris metadata.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=POLARIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# Spark/Iceberg logical settings.
ICEBERG_CATALOG=polaris
ICEBERG_NAMESPACE=lab
ICEBERG_TABLE=fnd01_test
