# Local development only. Copy to .env and change the values before starting Docker.
APP_ENV=local
LOG_LEVEL=INFO

# Pinned images and libraries used by FND-01.
RUSTFS_VERSION=1.0.0-alpha.81
POLARIS_VERSION=1.7.0
POLARIS_ADMIN_VERSION=1.7.0
POSTGRES_VERSION=18.6
SPARK_VERSION=3.5.9-java17-python3
ICEBERG_VERSION=1.10.1
ICEBERG_SPARK_RUNTIME_SHA256=39ea09e6c03550a300b9d9ab498949836d2d434e441da4c12a943a086e396940
ICEBERG_AWS_BUNDLE_SHA256=86bf20892ea5b4c17688f19b075399885f6aa5303f6b2dc9f491e76ceef9633b
AWS_CLI_VERSION=2.36.44
ALPINE_CURL_VERSION=8.22.0

# Host ports. Keep these defaults for normal FND-01 usage. FND-02 clean
# validation sets them to 0 so Docker assigns ephemeral ports without a clash.
RUSTFS_API_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001
POSTGRES_HOST_PORT=5432
POLARIS_CATALOG_HOST_PORT=8181
POLARIS_MANAGEMENT_HOST_PORT=8182

# Docker Hub manifest digests (linux/amd64; keep aligned with the version tags above).
RUSTFS_IMAGE_DIGEST=sha256:4ee605dfe7c6548d1fa1856357e8a1eccd929e3176acf933fafeba3ce09a69f9
POLARIS_IMAGE_DIGEST=sha256:3495f67f38cca33892a045f7dd3f46eb52387f0fd52d4145538a772fd8aedad7
POLARIS_ADMIN_IMAGE_DIGEST=sha256:3d8a24cea57aef3b71a0d7b09e5d2278d01e7e1b30071bf6648f2a6953322cca
POSTGRES_IMAGE_DIGEST=sha256:86c951e05bf56c93d95d397747fb8820ac76cc3bedb78f43abd83eedbe3666ae
SPARK_IMAGE_DIGEST=sha256:f3d6eaa8bab8ec2e38f3c3918a5b2f8b253c95bcb19f9e87ad0e0cdacf9df2d5
AWS_CLI_IMAGE_DIGEST=sha256:e8467f2c319f9bc9a1471808a69949a76915e9c95eaf4a09ece9f9e85fd32747
ALPINE_CURL_IMAGE_DIGEST=sha256:a39f52cab21d7e283448a9f73032dfb578ffcea9edaaa90c1d637117149b337f

# RustFS S3-compatible object storage (container network endpoint).
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_INTERNAL_ENDPOINT=http://rustfs:9000
RUSTFS_CONSOLE_ENDPOINT=http://localhost:9001
RUSTFS_BUCKET=data-platform
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=pdp_local_access
RUSTFS_SECRET_KEY=change-me-rustfs-secret

# Apache Polaris REST catalog.
POLARIS_ENDPOINT=http://localhost:8181/api/catalog
POLARIS_INTERNAL_ENDPOINT=http://polaris:8181/api/catalog
POLARIS_REALM=POLARIS
POLARIS_CATALOG=fnd01_catalog
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-me-polaris-secret

# PostgreSQL persistence for Polaris metadata.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=POLARIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# Leave the defaults for normal FND-01 runs. FND-02 clean validation overrides these names.
FND01_RUSTFS_VOLUME_NAME=pdp_fnd01_rustfs_data
FND01_POSTGRES_VOLUME_NAME=pdp_fnd01_postgres_data

# Spark/Iceberg logical settings.
ICEBERG_CATALOG=polaris
ICEBERG_NAMESPACE=lab
ICEBERG_TABLE=fnd01_test

# FND-04 local Control Plane. It uses a separate Compose project, database,
# credentials and volume; the defaults do not touch the Polaris PostgreSQL.
CONTROL_APP_ENV=local
CONTROL_LOG_LEVEL=INFO
CONTROL_API_HOST_PORT=8000
CONTROL_DB_HOST_PORT=5433
CONTROL_POSTGRES_VERSION=18.6
CONTROL_POSTGRES_IMAGE_DIGEST=sha256:86c951e05bf56c93d95d397747fb8820ac76cc3bedb78f43abd83eedbe3666ae
CONTROL_POSTGRES_VOLUME_NAME=pdp_control_postgres_data
CONTROL_DB_NAME=control_db
CONTROL_DB_USER=control_user
CONTROL_DB_PASSWORD=change-me-control-password
CONTROL_DATABASE_URL=postgresql+psycopg://control_user:change-me-control-password@localhost:5433/control_db
CONTROL_REQUIRED_MIGRATION_REVISION=0001_initial_control_plane
